---
import { profile } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <span class="brand-mark">TM</span>
      <div class="footer-info">
        <strong>{profile.brand}</strong> — Engenharia de Dados, BI, Automação e IA<br />
        Responsável técnico: {profile.name}<br />
        CNPJ {profile.cnpj} · Curitiba, PR
      </div>
    </div>

    <div class="footer-links">
      <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
      <a href={`mailto:${profile.email}`}>E-mail</a>
      <a href="#top">Voltar ao topo ↑</a>
    </div>

    <p class="footer-info">© {year} {profile.brand}. Todos os direitos reservados.</p>
  </div>
</footer>
