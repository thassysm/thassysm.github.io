---
import Icon from './Icon.astro';
import { profile } from '../data/site';

const wa = `https://wa.me/${profile.phoneRaw}?text=${encodeURIComponent(profile.whatsappMessage)}`;
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="hero-brand">
        <span class="hero-brand-mark">TM</span>
        <span class="hero-brand-name">{profile.brand}</span>
        <span class="status-pill"><span class="pulse"></span>Disponível para novos projetos</span>
      </div>

      <h1>
        <span>Dados que viram</span>
        <span class="gradient-text">decisão e resultado.</span>
      </h1>

      <p class="hero-sub">
        A <strong>{profile.brand}</strong> organiza, automatiza e transforma dados em decisão.
        São <strong>12+ anos de experiência</strong> em engenharia de dados, BI e IA aplicada,
        com entregas em saúde, finanças e operações críticas.
      </p>

      <div class="hero-actions">
        <a class="btn btn--primary" href={wa} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={17} />
          Vamos conversar
        </a>
        <a class="btn btn--ghost" href="#projetos">
          Ver projetos
          <Icon name="arrowRight" size={16} />
        </a>
      </div>

      <div class="hero-meta">
        <span><Icon name="pin" size={14} /> Curitiba, PR</span>
        <span><Icon name="globe" size={14} /> Atendimento remoto no Brasil</span>
        <span><Icon name="shield" size={14} /> AWS Certified</span>
      </div>
    </div>

    <div class="console" aria-hidden="true">
      <div class="console-top">
        <span class="console-dots"><i></i><i></i><i></i></span>
        <span class="console-title">pipeline / dados_financeiros</span>
        <span class="console-status">online</span>
      </div>

      <div class="console-body">
        <div class="console-label">
          <span>arquitetura medalhão</span>
          <span>2026</span>
        </div>

        <div class="pipe">
          <div class="pipe-row">
            <span>bronze</span>
            <span class="pipe-bar"><i></i></span>
            <span class="pipe-val">raw</span>
          </div>
          <div class="pipe-row">
            <span>silver</span>
            <span class="pipe-bar"><i></i></span>
            <span class="pipe-val">clean</span>
          </div>
          <div class="pipe-row">
            <span>gold</span>
            <span class="pipe-bar"><i></i></span>
            <span class="pipe-val">bi</span>
          </div>
        </div>

        <div class="spark-wrap">
          <div class="spark-head">
            <span class="spark-title">custo financeiro</span>
            <span class="spark-value">-16%<em>▼</em></span>
          </div>
          <svg class="spark" viewBox="0 0 320 56" preserveAspectRatio="none">
            <defs>
              <linearGradient id="spark-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#35e0a1" stop-opacity="0.28"></stop>
                <stop offset="100%" stop-color="#35e0a1" stop-opacity="0"></stop>
              </linearGradient>
              <linearGradient id="spark-line" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#38bdf8"></stop>
                <stop offset="100%" stop-color="#35e0a1"></stop>
              </linearGradient>
            </defs>
            <path
              d="M0 44 L26 38 L52 41 L78 30 L104 33 L130 24 L156 27 L182 18 L208 22 L234 13 L260 16 L286 9 L320 5"
              fill="none"
              stroke="url(#spark-line)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
            <path
              d="M0 44 L26 38 L52 41 L78 30 L104 33 L130 24 L156 27 L182 18 L208 22 L234 13 L260 16 L286 9 L320 5 L320 56 L0 56 Z"
              fill="url(#spark-fill)"
            ></path>
          </svg>
        </div>

        <div class="kpis">
          <div class="kpi"><b>12+</b><span>anos em dados</span></div>
          <div class="kpi"><b>80%</b><span>menos tempo em ETL</span></div>
          <div class="kpi"><b>60%</b><span>mais precisão em IA</span></div>
        </div>
      </div>
    </div>
  </div>
</section>
